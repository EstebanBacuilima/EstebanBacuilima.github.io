---
import SectionHeading from '../ui/SectionHeading.astro';
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<section id="about" class="border-y border-line bg-surface py-20" aria-labelledby="about-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading id="about-title" index="04 /" title={dict.about.title} />
    <div class="reveal max-w-2xl space-y-4 text-lg text-muted">
      {dict.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
