---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import { projects } from '../../data/projects';
import { t, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="projects-title">
  <SectionHeading id="projects-title" index="01 /" title={dict.projects.title} subtitle={dict.projects.subtitle} />
  <div class="space-y-10">
    {projects.map((p) => <ProjectCard project={p} locale={locale} />)}
  </div>
</section>
