---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { t, type Locale } from '../../i18n/utils';
import { site, whatsappUrl, mailtoUrl } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const channels = [
  { icon: 'mail', label: dict.contact.email, value: site.email, href: mailtoUrl, external: false },
  { icon: 'whatsapp', label: dict.contact.whatsapp, value: '+593 95 880 7968', href: whatsappUrl(dict.contact.whatsappMessage), external: true },
  { icon: 'github', label: dict.contact.github, value: 'EstebanBacuilima', href: site.github, external: true },
  { icon: 'linkedin', label: dict.contact.linkedin, value: 'Esteban Bacuilima', href: site.linkedin, external: true },
] as const;
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="contact-title">
  <SectionHeading id="contact-title" index="05 /" title={dict.contact.title} subtitle={dict.contact.subtitle} />
  <ul class="grid gap-4 sm:grid-cols-2">
    {channels.map((c) => (
      <li class="reveal">
        <a
          href={c.href}
          class="group flex items-center gap-4 rounded-xl border border-line bg-card p-5 transition hover:border-mint/50"
          {...c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >
          <span class="flex size-11 items-center justify-center rounded-lg bg-surface text-mint"><Icon name={c.icon} /></span>
          <span class="min-w-0">
            <span class="block font-mono text-xs text-muted">{c.label}</span>
            <span class="block truncate text-ink group-hover:text-mint">{c.value}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
