---
import SectionHeading from "../ui/SectionHeading.astro";
import SectionGlow from "../ui/SectionGlow.astro";
import TechChip from "../ui/TechChip.astro";
import TechIcon from "../ui/TechIcon.astro";
import { stackGroups } from "../../data/stack";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);

const span = {
  normal: "",
  wide: "md:col-span-2",
  full: "md:col-span-2 lg:col-span-3",
};

// Popovers are rendered up front (one per main technology) so they are translated, linkable
// from the chip with aria-controls, and need no JSON; the script only shows and positions them.
const popId = (gi: number, ii: number) => `tech-pop-${gi}-${ii}`;
const popovers = stackGroups.flatMap((g, gi) =>
  g.items.flatMap((item, ii) =>
    item.detail ? [{ id: popId(gi, ii), item, detail: item.detail }] : [],
  ),
);
---

<section
  id="stack"
  class="relative isolate py-20"
  aria-labelledby="stack-title"
>
  <SectionGlow
    blobs={[
      { tone: "lavender", at: "-right-[15%] top-0 -translate-y-1/3", strength: 11 },
      { tone: "mint", at: "-left-[15%] bottom-0 translate-y-1/3", strength: 10 },
    ]}
  />
  <!-- Faded dot grid: gives the glass cards texture to blur. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px); background-size: 26px 26px; mask-image: radial-gradient(ellipse at center, #000 25%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at center, #000 25%, transparent 75%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6" data-stack>
    <SectionHeading
      id="stack-title"
      index="02 /"
      title={dict.stack.title}
      subtitle={dict.stack.subtitle}
    />

    <div class="reveal mb-8 flex flex-wrap items-center gap-3" role="group" aria-label={dict.stack.filterLabel}>
      <button type="button" data-filter="core" aria-pressed="false" class="legend-btn">
        <span class="size-2 rounded-full bg-mint" aria-hidden="true"></span>
        {dict.stack.legendCore}
      </button>
      <button type="button" data-filter="familiar" aria-pressed="false" class="legend-btn">
        <span class="size-2 rounded-full border border-dashed border-muted" aria-hidden="true"></span>
        {dict.stack.legendFamiliar}
      </button>
      <p class="text-xs text-muted">{dict.stack.hint}</p>
    </div>

    <div class="stack-grid grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-stack-grid>
      {
        stackGroups.map((g, gi) => (
          <div
            class:list={[
              "spotlight reveal rounded-2xl border border-white/10 bg-card/60 p-5 backdrop-blur-md",
              span[g.size],
            ]}
            style={`--i:${gi % 3}`}
          >
            <h3 class="font-mono text-sm text-mint">{g.title[locale]}</h3>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {g.items.map((item, ii) => (
                <li>
                  <TechChip item={item} popId={item.detail ? popId(gi, ii) : undefined} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      popovers.map(({ id, item, detail }) => (
        <div
          id={id}
          role="dialog"
          aria-label={item.name}
          hidden
          class="stack-pop absolute z-20 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-white/10 bg-card/95 p-4 text-left shadow-2xl shadow-black/50 backdrop-blur-md"
        >
          <div class="flex items-center gap-2">
            {item.icon && <TechIcon name={item.icon} class="size-5 text-mint" />}
            <h4 class="font-semibold text-ink">{item.name}</h4>
          </div>
          <p class="mt-1 text-sm text-mint">{detail.role[locale]}</p>
          {detail.libs && (
            <>
              <p class="mt-3 text-xs text-muted">{dict.stack.detail.libs}</p>
              <ul class="mt-1.5 flex flex-wrap gap-1.5">
                {detail.libs.map((l) => (
                  <li class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[11px] text-ink">{l}</li>
                ))}
              </ul>
            </>
          )}
          {detail.usedIn && (
            <>
              <p class="mt-3 text-xs text-muted">{dict.stack.detail.usedIn}</p>
              <ul class="mt-1.5 flex flex-wrap gap-1.5">
                {detail.usedIn.map((u) => (
                  <li class="rounded-md border border-mint/20 bg-mint/5 px-2 py-0.5 font-mono text-[11px] text-mint">{u}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-stack]");
  const grid = root?.querySelector<HTMLElement>("[data-stack-grid]");

  if (root && grid) {
    // Legend as a filter: click toggles one tier, click again clears it. CSS does the dimming.
    const filters = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
    filters.forEach((btn) =>
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("aria-pressed") === "true" ? "" : btn.dataset.filter!;
        filters.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.filter === next)));
        if (next) grid.dataset.filter = next;
        else delete grid.dataset.filter;
      }),
    );

    // Spotlight: the card under the cursor gets --sx/--sy; one rAF per frame at most.
    if (matchMedia("(pointer: fine)").matches) {
      let frame = 0;
      let card: HTMLElement | null = null;
      let x = 0;
      let y = 0;
      grid.addEventListener(
        "pointermove",
        (e) => {
          card = (e.target as HTMLElement).closest<HTMLElement>(".spotlight");
          x = e.clientX;
          y = e.clientY;
          if (!card || frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty("--sx", `${x - r.left}px`);
            card.style.setProperty("--sy", `${y - r.top}px`);
          });
        },
        { passive: true },
      );
    }

    // Popover: one open at a time. Its dismiss listeners exist only while it is open.
    let current: HTMLButtonElement | null = null;

    const onOutside = (e: PointerEvent) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".stack-pop") && !target.closest("button[aria-controls]")) close(false);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") close(true);
    };
    const onResize = () => close(false);

    function close(restoreFocus: boolean) {
      if (!current) return;
      document.getElementById(current.getAttribute("aria-controls")!)!.hidden = true;
      current.setAttribute("aria-expanded", "false");
      if (restoreFocus) current.focus();
      current = null;
      document.removeEventListener("pointerdown", onOutside);
      document.removeEventListener("keydown", onKey);
      window.removeEventListener("resize", onResize);
    }

    function open(btn: HTMLButtonElement) {
      close(false);
      const pop = document.getElementById(btn.getAttribute("aria-controls")!)!;
      pop.hidden = false;
      // Position inside `root` (position: relative), centred under the chip and kept in the column.
      const base = root!.getBoundingClientRect();
      const chip = btn.getBoundingClientRect();
      const center = chip.left - base.left + chip.width / 2;
      const left = Math.min(Math.max(center - pop.offsetWidth / 2, 0), base.width - pop.offsetWidth);
      pop.style.left = `${left}px`;
      pop.style.top = `${chip.bottom - base.top + 10}px`;
      pop.style.setProperty("--ax", `${center - left}px`);
      btn.setAttribute("aria-expanded", "true");
      current = btn;
      document.addEventListener("pointerdown", onOutside);
      document.addEventListener("keydown", onKey);
      window.addEventListener("resize", onResize);
    }

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[aria-controls]");
      if (!btn) return;
      if (btn === current) close(false);
      else open(btn);
    });
  }
</script>
