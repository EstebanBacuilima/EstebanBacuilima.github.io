---
import Icon from '../ui/Icon.astro';
import { t, type Locale } from '../../i18n/utils';
import { whatsappUrl } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<a
  href={whatsappUrl(dict.contact.whatsappMessage)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={dict.a11y.whatsapp}
  class="fixed bottom-4 right-4 z-40 flex size-12 items-center justify-center rounded-full bg-mint text-bg shadow-lg shadow-black/40 transition hover:scale-105 hover:bg-white sm:bottom-6 sm:right-6"
  style="margin-bottom: env(safe-area-inset-bottom)"
>
  <Icon name="whatsapp" class="size-6" />
</a>
