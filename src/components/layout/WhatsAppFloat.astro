---
import { Image } from "astro:assets";
import { t, type Locale } from "../../i18n/utils";
import { whatsappUrl } from "../../data/site";
import whatsappIcon from "../../assets/icons/whatsapp.png";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<a
  href={whatsappUrl(dict.contact.whatsappMessage)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={dict.a11y.whatsapp}
  class="fixed bottom-4 right-4 z-40 transition-transform duration-300 hover:scale-125 sm:bottom-6 sm:right-6"
  style="margin-bottom: env(safe-area-inset-bottom)"
>
  <Image
    src={whatsappIcon}
    alt=""
    class="size-12 motion-safe:animate-bounce drop-shadow-md sm:size-14"
  />
</a>
