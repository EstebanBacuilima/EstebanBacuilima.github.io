---
import { t, homePath, otherLocale, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const other = otherLocale(locale);

const links = [
  { href: '#projects', label: dict.nav.projects },
  { href: '#stack', label: dict.nav.stack },
  { href: '#educational', label: dict.nav.educational },
  { href: '#about', label: dict.nav.about },
  { href: '#contact', label: dict.nav.contact },
];
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-mint focus:px-4 focus:py-2 focus:text-bg"
>
  {dict.a11y.skip}
</a>

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-bg/80 backdrop-blur">
  <div class="scroll-progress absolute inset-x-0 -bottom-px h-0.5 origin-left bg-mint" aria-hidden="true"></div>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label={dict.a11y.nav}>
    <a href={homePath(locale)} class="flex items-center gap-2 font-mono text-sm font-semibold text-ink">
      <span class="text-mint" aria-hidden="true">&lt;/&gt;</span> esteban.dev
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="link-u rounded-md px-3 py-2 text-sm text-muted hover:text-mint aria-[current]:text-mint">{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={homePath(other)}
        hreflang={other}
        lang={other}
        class="rounded-md border border-line px-3 py-1.5 font-mono text-xs font-semibold uppercase text-muted transition hover:border-mint/60 hover:text-mint"
        aria-label={`${dict.a11y.lang}: ${other === 'es' ? 'Español' : 'English'}`}
      >
        {other}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-line p-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={dict.a11y.menuOpen}
        data-open-label={dict.a11y.menuOpen}
        data-close-label={dict.a11y.menuClose}
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path id="menu-icon" d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"></path></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-6">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block rounded-md px-3 py-3 text-base text-ink hover:text-mint aria-[current]:text-mint">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');
  const burger = 'M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z';
  const cross = 'M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z';

  function setOpen(open: boolean) {
    if (!btn || !menu || !icon) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? '');
    icon.setAttribute('d', open ? cross : burger);
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Scrollspy: one observer marks the section crossing the middle of the viewport.
  const links = document.querySelectorAll<HTMLAnchorElement>('header a[href^="#"]');
  const byId = new Map<string, HTMLAnchorElement[]>();
  links.forEach((a) => {
    const id = a.getAttribute('href')!.slice(1);
    byId.set(id, [...(byId.get(id) ?? []), a]);
  });
  if ('IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(entry.target.id)?.forEach((a) => a.setAttribute('aria-current', 'location'));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    byId.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) spy.observe(section);
    });
    // The hero has no nav link: observing it clears the highlight when scrolling back to the top.
    const hero = document.getElementById('top');
    if (hero) spy.observe(hero);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });
</script>
