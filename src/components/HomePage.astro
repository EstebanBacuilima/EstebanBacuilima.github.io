---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "./layout/Navbar.astro";
import Footer from "./layout/Footer.astro";
import WhatsAppFloat from "./layout/WhatsAppFloat.astro";
import Hero from "./sections/Hero.astro";
import Projects from "./sections/Projects.astro";
import Stack from "./sections/Stack.astro";
import Educational from "./sections/Educational.astro";
import About from "./sections/About.astro";
import Contact from "./sections/Contact.astro";
import type { Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
  <Navbar locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Stack locale={locale} />
    <Educational locale={locale} />
    <Projects locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <WhatsAppFloat locale={locale} />
</BaseLayout>
