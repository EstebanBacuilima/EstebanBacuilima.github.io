---
import { icons, type IconKey } from '../../data/stack-icons';

interface Props {
  name: IconKey;
  class?: string;
}
const { name, class: className = 'size-3.5' } = Astro.props;
const icon = icons[name];
---

{
  icon.kind === 'brand' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d={icon.path} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={icon.svg}
    />
  )
}
