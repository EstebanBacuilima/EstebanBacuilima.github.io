---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  index: string;
}
const { id, title, subtitle, index } = Astro.props;
---

<header class="reveal mb-10 max-w-2xl">
  <p class="mb-2 font-mono text-sm text-mint" aria-hidden="true">{index}</p>
  <h2 id={id} class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</header>
